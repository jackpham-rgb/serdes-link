	(text "1 in 50 ohm microstrip, same launch as the 12 in lines" (at 77.47 113.03 0) (effects (font (size 1.4 1.4))) (uuid "459b5d23-5594-4874-bb1d-228bd1a648b1"))
	(text "SerDes Link test channel" (at 12.7 15.24 0) (effects (font (size 3 3) bold) (justify left)) (uuid "8ae15478-83c5-46be-b1e5-a7795987de25"))
	(text "J1-J3 and J2-J4 are the two halves of the differential channel,\nmeasured as a 4-port in the order TX+, TX-, RX+, RX-." (at 12.7 22.86 0) (effects (font (size 1.4 1.4)) (justify left)) (uuid "f317e417-3073-478f-8e92-1104aa27e9e2"))
	(text "J5-J6 is the thru line, measured to remove the connector and launch\nfrom the 12 in results. Every shield ties to the ground pour and stitching vias." (at 12.7 30.48 0) (effects (font (size 1.4 1.4)) (justify left)) (uuid "56adb00e-d5ea-40aa-8534-71ff1777cad9"))
